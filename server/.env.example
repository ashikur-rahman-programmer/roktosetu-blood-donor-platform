# --- MongoDB ---
# Your MongoDB Atlas (or self-hosted) connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=roktosetu

# --- Better Auth ---
# Generate a long random string, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=change-this-to-a-long-random-string
# The public URL of THIS backend once deployed (Render/Railway URL).
BETTER_AUTH_URL=https://your-backend.onrender.com

# --- Server ---
PORT=4000
NODE_ENV=production

# Comma-separated list of frontend origins allowed to call this API.
# Must exactly match your deployed Vercel URL(s), no trailing slash.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# --- Product rules ---
# Days a donor must wait between donations before auto-becoming available again.
DONATION_GAP_DAYS=90
# Cron schedule (node-cron syntax) for the daily availability-reset job.
AVAILABILITY_CRON_SCHEDULE=5 0 * * *
